# Rust build outputs
/target/
/target-container/
/target-container-fuzz/

# Fuzzing byproducts (corpus seeds may be committed deliberately;
# crash artifacts and raw corpora are not)
/fuzz/target/
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/Cargo.lock

# Runtime/dev artifacts: default sqlite DB and `otel-sqlite gen-certs`
# output (never commit private keys)
*.db
*.db-shm
*.db-wal
*.pem
*.key

# Local run outputs and IDE state
/logs/
/results/
/.idea/

# Keep the Docker build context small: only manifests, crates, tests and
# proto files are COPYed, but the whole context is uploaded to the daemon on
# every build. Without this file, multi-GB target/ directories dominate the
# upload.

target/
target-container/
.git/
.idea/
.github/
docs/
results/
logs/
*.db
*.db-shm
*.db-wal
# Generated PKI/keys must never reach builder image layers: the Dockerfile
# copies crates/ wholesale, and `gen-certs` writes alongside the sources.
*.key
*.pem
*.otsb
certs/
tests/docker/compose.*.yml
Dockerfile
tests/docker/Dockerfile.benchmark

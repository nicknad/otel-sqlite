# Copy to `.act.env` (or edit it in place) to override act environment
# defaults for every job. The committed `.act.env` already sets safe values;
# add anything you need locally here, e.g.:

# Human-friendly log level inside the containers.
RUST_LOG=info
CARGO_TERM_COLOR=always

# GitHub token for actions that hit the API (checkout@v5 works locally
# without one; used by actions that create PRs/issues or push).
# GITHUB_TOKEN=ghp_xxx

# Flag for `if:` conditions: `${{ env.ACT }}` is set by act automatically.
stateDiagram-v2
  state "Legend" as legend {
    lg0: Intake
    lg1: Commit
    lg2: Accepted
    lg3: Partial
    lg4: Rejected
  }
  class lg0 blue
  class lg1 yellow
  class lg2 teal
  class lg3 tan
